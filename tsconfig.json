{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Pinned deliberately. With `types` unset, TypeScript auto-includes every
    // folder under node_modules/@types and fails with TS2688 on any that lacks
    // an entry point — and 9 orphaned husk dirs survive there from the
    // next-sanity/@sanity/client removal (OneDrive held the directories open
    // while npm deleted their contents). Allowlisting the three packages that
    // actually supply globals makes typecheck immune to that. Module
    // resolution is unaffected, and next-env.d.ts reaches Next's types via
    // triple-slash references, which bypass this list.
    "types": ["node", "react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
